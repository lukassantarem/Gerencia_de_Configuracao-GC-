pipeline {
    agent any

    stages {
        stage('Instalar dependências') {
            steps {
                dir('Jenkins/temperature-converter') {
                    bat '"C:\\Users\\Lucas\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pip install -r requirements.txt'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Jenkins/temperature-converter') {
                    bat '"C:\\Users\\Lucas\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m compileall -q src'
                }
            }
        }

        stage('Testes') {
            steps {
                dir('Jenkins/temperature-converter') {
                    bat 'if not exist reports mkdir reports'

                    script {
                        def resultado = bat(
                            returnStatus: true,
                            script: '"C:\\Users\\Lucas\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pytest --junitxml=reports\\test-results.xml'
                        )

                        junit testResults: 'Jenkins/temperature-converter/reports/test-results.xml'

                        if (resultado != 0) {
                            echo 'Alguns testes falharam.'
                        }
                    }
                }
            }
        }
    }
}
